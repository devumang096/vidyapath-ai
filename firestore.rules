rules_version = '2';

// EduOrbit Firestore rules.
// Principle: the client may read its own data and public content, and may write only
// profile preferences, projects, buddy preferences, blocks, reports and notification read flags.
// Everything that carries value (XP, Orbit Coins, streaks, mastery, attempts, redemptions,
// group roles) is written exclusively by Cloud Functions with the Admin SDK, which bypasses
// these rules. See SECURITY.md for the full matrix.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function ownsDoc() { return signedIn() && resource.data.userId == request.auth.uid; }
    function onlyFields(allowed) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed); }
    function validClass(value) { return value is int && value >= 9 && value <= 12; }
    function validGoal(value) { return value in ['school', 'jee', 'neet', 'school_jee', 'school_neet']; }
    function validLanguage(value) { return value in ['en', 'hi']; }
    function validLearningLevel(value) { return value in ['beginner', 'intermediate', 'advanced']; }
    // The only four subjects EduOrbit has. Nothing else may be stored anywhere.
    function validSubjects(value) { return value is list && value.size() <= 4 && value.hasOnly(['physics', 'chemistry', 'mathematics', 'biology']); }
    function validName(value) { return value is string && value.size() >= 1 && value.size() <= 60; }
    function validOptionalString(value, max) { return value == null || (value is string && value.size() <= max); }
    function validDailyGoal(value) { return value is int && value >= 15 && value <= 720; }
    function validPrefs(value) {
      return value is map && value.keys().hasOnly(['streak', 'dailyGoal', 'weakTopic', 'assessment', 'buddy', 'group', 'reward']);
    }
    function isGroupMember(groupId) { return signedIn() && exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid)); }
    function isGroupStaff(groupId) { return isGroupMember(groupId) && get(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid)).data.role in ['owner', 'admin']; }

    // ---------- content: readable when signed in, written only by admins / the seed script ----------
    match /subjects/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /chapters/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /topics/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /lessons/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /questions/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /assessments/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /rewards/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /badges/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /appConfig/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Answer keys never reach the client directly; grading happens in Cloud Functions.
    match /questionKeys/{id} { allow read, write: if isAdmin(); }

    // ---------- private user record ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && validUserCreate(uid);
      allow update: if (isOwner(uid) && validUserUpdate()) || (isAdmin() && onlyFields(['role', 'updatedAt']));
      allow delete: if false;
    }
    function validUserProfile(data) {
      return validName(data.name)
        && validClass(data.classLevel) && validGoal(data.goal) && validSubjects(data.subjects)
        && validLanguage(data.language) && validLearningLevel(data.learningLevel) && validDailyGoal(data.dailyGoalMinutes)
        && validOptionalString(data.school, 120) && validOptionalString(data.phone, 20) && validOptionalString(data.photoURL, 500)
        && data.onboardingComplete is bool && validPrefs(data.notificationPrefs);
    }
    function validUserCreate(uid) {
      let data = request.resource.data;
      return data.uid == uid
        && data.email == request.auth.token.email
        && validUserProfile(data)
        && data.role == 'student'
        && data.xp == 0 && data.coins == 0 && data.questionsSolved == 0 && data.lessonsCompleted == 0
        && data.chaptersCompleted == 0 && data.assessmentsCompleted == 0 && data.totalStudyMinutes == 0 && data.activeDays == 0
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function validUserUpdate() {
      let data = request.resource.data;
      return onlyFields(['name', 'classLevel', 'goal', 'subjects', 'language', 'learningLevel', 'dailyGoalMinutes', 'school', 'phone', 'photoURL', 'onboardingComplete', 'notificationPrefs', 'updatedAt'])
        && validUserProfile(data)
        && data.updatedAt == request.time;
    }

    // Anonymous public profile. Derived server-side from users/{uid}; no email, name or contact info.
    match /publicProfiles/{uid} { allow read: if signedIn(); allow write: if false; }

    // ---------- server-only learning state, owner readable ----------
    match /streaks/{uid} { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }
    match /spinState/{uid} { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }
    match /userBadges/{uid}/badges/{id} { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }
    match /lessonProgress/{id} { allow read: if ownsDoc() || isAdmin(); allow write: if false; }
    match /chapterProgress/{id} { allow read: if ownsDoc() || isAdmin(); allow write: if false; }
    match /topicMastery/{id} { allow read: if ownsDoc() || isAdmin(); allow write: if false; }
    match /questionAttempts/{id} { allow read: if ownsDoc() || isAdmin(); allow write: if false; }
    match /assessmentAttempts/{id} { allow read: if ownsDoc() || isAdmin(); allow write: if false; }
    match /learningSessions/{id} { allow read: if ownsDoc(); allow write: if false; }
    match /xpTransactions/{id} { allow read: if ownsDoc() || isAdmin(); allow write: if false; }
    match /coinTransactions/{id} { allow read: if ownsDoc() || isAdmin(); allow write: if false; }
    match /spinHistory/{id} { allow read: if ownsDoc(); allow write: if false; }
    match /aiConversations/{id} { allow read: if ownsDoc(); allow write: if false; }
    match /aiMessages/{id} { allow read: if ownsDoc(); allow write: if false; }
    match /dailyActivity/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }
    match /aiUsage/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }
    match /processedEvents/{id} { allow read, write: if false; }

    match /redemptions/{id} {
      allow read: if ownsDoc() || isAdmin();
      allow update: if isAdmin() && onlyFields(['status']) && request.resource.data.status in ['pending', 'approved', 'fulfilled', 'rejected'];
      allow create, delete: if false;
    }

    // ---------- buddy: requests, pairs, rooms and challenges are server-written ----------
    match /buddyPreferences/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validBuddyPreferences(uid);
      allow delete: if isOwner(uid);
    }
    function validBuddyPreferences(uid) {
      let data = request.resource.data;
      return data.uid == uid && data.open is bool && validSubjects(data.subjects)
        && data.schedule in ['morning', 'afternoon', 'evening', 'night', 'flexible']
        && data.genderPreference in ['any', 'same'] && data.gender in ['female', 'male', 'other', 'unspecified']
        && data.updatedAt == request.time;
    }
    match /buddyRequests/{id} { allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid); allow write: if false; }
    match /buddies/{id} { allow read: if signedIn() && request.auth.uid in resource.data.members; allow write: if false; }
    match /buddySessions/{id} { allow read: if signedIn() && request.auth.uid in resource.data.members; allow write: if false; }
    match /buddyChallenges/{id} { allow read: if signedIn() && request.auth.uid in resource.data.members; allow write: if false; }

    // ---------- groups: public groups are discoverable, everything inside is members-only, all writes via Functions ----------
    match /groups/{groupId} {
      allow read: if signedIn() && (resource.data.privacy == 'public' || isGroupMember(groupId) || isAdmin());
      allow write: if false;
    }
    match /groupMembers/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || isGroupMember(resource.data.groupId) || isAdmin()); allow write: if false; }
    match /groupJoinRequests/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || isGroupMember(resource.data.groupId)); allow write: if false; }
    match /groupInvitations/{id} { allow read: if signedIn() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid); allow write: if false; }
    match /groupInviteCodes/{id} { allow read: if isGroupMember(resource.data.groupId); allow write: if false; }
    match /groupPosts/{id} { allow read: if isGroupMember(resource.data.groupId) && (resource.data.hidden == false || resource.data.authorUid == request.auth.uid || isAdmin()); allow write: if false; }
    match /groupReplies/{id} { allow read: if isGroupMember(resource.data.groupId) && (resource.data.hidden == false || resource.data.authorUid == request.auth.uid || isAdmin()); allow write: if false; }
    match /groupReports/{id} { allow read: if isAdmin() || isGroupStaff(resource.data.groupId) || (signedIn() && resource.data.reporterUid == request.auth.uid); allow write: if false; }
    match /groupPostReactions/{id} { allow read: if isGroupMember(resource.data.groupId); allow write: if false; }
    match /groupSessions/{id} { allow read: if isGroupMember(resource.data.groupId); allow write: if false; }
    match /groupChallenges/{id} { allow read: if isGroupMember(resource.data.groupId); allow write: if false; }

    // ---------- owner-writable, validated ----------
    match /studyPlans/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validStudyPlan(uid);
      allow delete: if isOwner(uid);
    }
    function validStudyPlan(uid) {
      let data = request.resource.data;
      return data.uid == uid
        && data.minutesPerDay is int && data.minutesPerDay >= 15 && data.minutesPerDay <= 720
        && (data.examDate == null || (data.examDate is string && data.examDate.size() == 10))
        && validSubjects(data.subjects)
        && data.allocation is map
        && data.focusTopicIds is list && data.focusTopicIds.size() <= 20
        && data.updatedAt == request.time;
    }

    match /projects/{id} {
      allow read: if ownsDoc();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && validProject() && request.resource.data.createdAt == request.time;
      allow update: if ownsDoc() && request.resource.data.userId == request.auth.uid && validProject() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsDoc();
    }
    function validProject() {
      let data = request.resource.data;
      return data.id is string && data.id.size() <= 80
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.goal is string && data.goal.size() <= 500
        && validOptionalString(data.startDate, 10) && validOptionalString(data.deadline, 10)
        && data.status in ['not_started', 'in_progress', 'completed']
        && data.notes is string && data.notes.size() <= 5000
        && data.resources is list && data.resources.size() <= 30
        && data.taskCount is int && data.taskCount >= 0 && data.completedTaskCount is int && data.completedTaskCount >= 0
        && data.updatedAt == request.time;
    }
    match /projectTasks/{id} {
      allow read: if ownsDoc();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && validProjectTask() && request.resource.data.createdAt == request.time;
      allow update: if ownsDoc() && request.resource.data.userId == request.auth.uid && validProjectTask();
      allow delete: if ownsDoc();
    }
    function validProjectTask() {
      let data = request.resource.data;
      return data.id is string && data.id.size() <= 80 && data.projectId is string && data.projectId.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.done is bool && validOptionalString(data.dueDate, 10)
        && data.order is int && data.updatedAt == request.time;
    }

    match /notifications/{uid}/items/{id} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && onlyFields(['read']) && request.resource.data.read is bool;
      allow create, delete: if false;
    }

    match /blocks/{uid}/users/{blockedUid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && blockedUid != uid
        && request.resource.data.blockedUid == blockedUid
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    match /reports/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if signedIn() && validReport();
      allow update: if isAdmin() && onlyFields(['status']) && request.resource.data.status in ['open', 'resolved', 'dismissed'];
      allow delete: if false;
    }
    function validReport() {
      let data = request.resource.data;
      return data.reporterId == request.auth.uid
        && data.targetType in ['user', 'buddy', 'group', 'group_post', 'group_reply']
        && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 120
        && validOptionalString(data.groupId, 120)
        && data.reason in ['spam', 'abuse', 'irrelevant', 'inappropriate', 'harassment', 'contact_sharing', 'other']
        && data.details is string && data.details.size() <= 1000
        && data.status == 'open'
        && data.createdAt == request.time;
    }
  }
}
