# Frontend (Vite) - safe to expose, restricted by Firestore rules and App Check
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to true to point the app at the local Firebase Emulator Suite
VITE_USE_EMULATORS=false

# Seeding (server side only, never shipped to the browser)
# Path to a Firebase service account JSON. Leave empty when seeding the emulator.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
DEMO_STUDENT_EMAIL=aarav@vidyapath.demo
DEMO_STUDENT_PASSWORD=
DEMO_ADMIN_EMAIL=admin@vidyapath.demo
DEMO_ADMIN_PASSWORD=
DEMO_PEER_PASSWORD=
